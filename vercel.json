            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/public/storage/$1"
        },
        {
            "src": "^/(favicon\\.ico|robots\\.txt)$",
            "dest": "/public/$1"
        },
        {
            "src": "(.*)",
            "dest": "/api/index.php"
        }
    ],
